{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-coding-agent": ["./node_modules/@earendil-works/pi-coding-agent"],
      "@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai"],
      "@earendil-works/pi-tui": ["./node_modules/@earendil-works/pi-tui"],
      "typebox": ["./node_modules/typebox"]
    },
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["../../internal/config/data/pebbles-pi.ts"]
}
